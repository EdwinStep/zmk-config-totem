#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1250
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

#include <dt-bindings/zmk/pointing.h>

#include "keys_lt.h"

#define BASE_COL 0
#define BASE_GAL 1
#define NAV  2
#define MOUSE 3
#define LTU_COL 4
#define LTU_GAL 5
#define MEDIA 6
#define NUM 7
#define SYM 8
#define FUN 9

&mt {
  quick-tap-ms = <100>;
  global-quick-tap;
  flavor = "tap-preferred";
  tapping-term-ms = <200>;
};
&mmv {
  acceleration-exponent = <1>;
  time-to-max-speed-ms = <1500>;
  delay-ms = <0>;
};
&msc {
  acceleration-exponent = <1>;
  time-to-max-speed-ms = <5000>;
  delay-ms = <0>;
};

/ {
        keymap {
                compatible = "zmk,keymap";
                base_col_layer {
                        label= "BASE_COL";
                        bindings = <
                                         &kp Q      &kp W      &kp F         &kp P         &kp B         &kp J       &kp L       &kp U         &kp Y      &kp SQT
                                         &mt LGUI A &mt LALT R &mt LCTRL S   &mt LSHFT T   &kp G         &kp M       &mt LSHFT N &mt LCTRL E   &mt LALT I &mt RGUI O
                                &kp RALT &kp Z      &kp X      &lt LTU C     &kp D         &kp V         &kp K       &kp H       &lt LTU_COL COMMA &kp DOT    &kp FSLH   &kp RALT
                                                               &lt MEDIA ESC &lt NAV SPACE &lt MOUSE TAB &lt SYM RET &lt NUM BSPC &lt FUN DEL
                        >;
                };
                base_gal_layer {
                        label= "BASE_GAL";
                        bindings = <
                                         &kp B      &kp L      &kp D         &kp C         &kp V         &kp J       &kp Y        &kp O         &kp U      &kp COMMA
                                         &mt LGUI N &mt LALT R &mt LCTRL T   &mt LSHFT S   &kp G         &kp P       &mt LSHFT H  &mt LCTRL A   &mt LALT E &mt RGUI I
                                &kp RALT &kp X      &kp Q      &lt LTU M     &kp W         &kp Z         &kp K       &kp F        &lt LTU_GAL SQT   &kp SEMI   &kp DOT   &kp RALT
                                                               &lt MEDIA ESC &lt NAV SPACE &lt MOUSE TAB &lt SYM RET &lt NUM BSPC &lt FUN DEL
                        >;
                };
                nav_layer {
                        label= "NAV";
                        bindings = <
                                         &none    &none    &none     &none     &none &none    &none    &none     &none     &none
                                         &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none &kp CAPS &kp LEFT &kp DOWN  &kp UP    &kp RIGHT
                                &kp RALT &none    &none    &none     &none     &none &kp INS  &kp HOME &kp PG_DN &kp PG_UP &kp END   &none
                                                           &none     &none     &none &kp RET  &kp BSPC &kp DEL
                        >;
                };
                mouse_layer {
                        label= "MOUSE";
                        bindings = <
                                         &none    &none    &none     &none     &none &none    &none          &none          &none        &none
                                         &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none &none    &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT
                                &kp RALT &none    &none    &none     &none     &none &none    &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT   &none
                                                           &none     &none     &none &mkp MB2 &mkp MB1       &mkp MB3
                        >;
                };
                ltu_col_layer {
                        label= "LTU_COL";
                        bindings = <
                                      &none            &none       &none             &none       &none       &none       &none       &kp LT_UOGO       &kp LT_UMAC      &none
                                      &mt LGUI LT_AOGO &kp LALT    &mt LCTRL LT_SCAR &kp LSHFT   &none       &none       &kp LSHFT   &mt LCTRL LT_EOGO &mt LALT LT_IOGO &mt LGUI LT_EDOT
                                &none &kp LT_ZCAR      &none       &kp LT_CCAR       &none       &none       &none       &none       &none             &none            &none            &none
                                                                   &none             &none       &none       &none       &none       &none 
                        >;
                };
                ltu_gal_layer {
                        label= "LTU_GAL";
                        bindings = <
                                      &none    &none    &none     &kp LT_CCAR       &none       &none       &kp LT_UMAC &kp LT_EDOT       &kp LT_UOGO      &none
                                      &kp LGUI &kp LALT &kp LCTRL &mt LSHFT LT_SCAR &none       &none       &kp LSHFT   &mt LCTRL LT_AOGO &mt LALT LT_EOGO &mt LGUI LT_IOGO
                                &none &none    &none    &none     &none             &kp LT_ZCAR &none       &none       &none             &none            &none            &none
                                                        &none     &none             &none       &none       &none       &none
                        >;
                };
                media_layer {
                        label= "MEDIA";
                        bindings = <
                                         &none    &none    &none     &none     &none &none &bt BT_NXT &bt BT_PRV   &bt BT_CLR   &out OUT_TOG
                                         &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &none &none &kp C_PREV &kp C_VOL_DN &kp C_VOL_UP &kp C_NEXT
                                &kp RALT &none    &none    &none     &none     &none &none &none      &none        &none        &none        &none
                                                           &none     &none     &none &none &kp C_PP   &kp C_MUTE
                        >;
                };
                num_layer {
                        label= "NUM";
                        bindings = <
                                      &kp LT_LBKT  &kp LT_7 &kp LT_8   &kp LT_9 &kp LT_RBKT  &none &none     &none     &none    &none
                                      &kp LT_QMARK &kp LT_4 &kp LT_5   &kp LT_6 &kp LT_EQUAL &none &kp LSHFT &kp LCTRL &kp LALT &kp LGUI
                                &none &kp LT_GRAVE &kp LT_1 &kp LT_2   &kp LT_3 &kp LT_BSLH  &none &none     &none     &none    &none    &kp RALT
                                                            &kp LT_DOT &kp LT_0 &kp LT_MINUS &none &none     &none
                        >;
                };
                sym_layer {
                        label= "SYM";
                        bindings = <
                                      &kp LT_LBRC &kp LT_AMPR &kp LT_ASTR &kp LT_LPAR &kp LT_RBRC &none &none     &none     &none    &none
                                      &kp LT_FSLH &kp LT_DLR  &kp LT_PERC &kp LT_CIRC &kp LT_PLUS &none &kp LSHFT &kp LCTRL &kp LALT &kp LGUI
                                &none &kp LT_TILD &kp LT_EXCL &kp LT_AT   &kp LT_HASH &kp LT_PIPE &none &none     &none     &none    &none    &kp RALT
                                                              &kp LT_DOT  &kp LT_RPAR &kp LT_UNDS &none &none     &none
                        >;
                };
                fun_layer {
                        label= "FUN";
                        bindings = <
                                       &kp F12 &kp F7 &kp F8    &kp F9    &kp PSCRN       &none &none     &none     &none    &none
                                       &kp F11 &kp F4 &kp F5    &kp F6    &kp SLCK        &none &kp LSHFT &kp LCTRL &kp LALT &kp LGUI
                                &tog 1 &kp F10 &kp F1 &kp F2    &kp F3    &kp PAUSE_BREAK &none &none     &none     &none    &none    &kp RALT
                                                      &kp K_APP &kp SPACE &kp TAB         &none &none     &none
                        >;
                };
        };
};
